{
  "$schema": "https://registry.tabularis.dev/manifest.schema.json?kind=driver",
  "id": "surrealdb",
  "name": "SurrealDB",
  "version": "0.1.0",
  "description": "Connect to a SurrealDB namespace and database, browse schemafull and schemaless tables, fields and indexes, inspect records and run native SurrealQL.",
  "kind": "driver",
  "engine": "surrealdb",
  "paradigms": ["document", "graph", "relational", "key-value", "vector"],
  "license": "Apache-2.0",
  "tags": ["surrealdb", "surrealql", "multi-model", "graph", "document"],
  "readme": "README.md",
  "support": {
    "issues_url": "https://github.com/TabularisDB/tabularis-surrealdb-plugin/issues"
  },
  "color": "#ff00a0",
  "default_port": 8000,
  "default_username": "root",
  "executable": "surrealdb-plugin",
  "capabilities": {
    "schemas": false,
    "views": false,
    "routines": false,
    "triggers": false,
    "file_based": false,
    "folder_based": false,
    "no_connection_required": false,
    "connection_string": true,
    "connection_string_example": "surrealdb://root:root@localhost:8000/namespace/database",
    "identifier_quote": "`",
    "sql_dialect": "mysql",
    "table_query_templates": true,
    "alter_primary_key": false,
    "alter_column": false,
    "create_foreign_keys": false,
    "manage_tables": false,
    "readonly": true,
    "explain": false,
    "supports_ssl": false
  },
  "data_types": [
    { "name": "any", "category": "other", "requires_length": false, "requires_precision": false },
    { "name": "bool", "category": "boolean", "requires_length": false, "requires_precision": false },
    { "name": "int", "category": "numeric", "requires_length": false, "requires_precision": false },
    { "name": "float", "category": "numeric", "requires_length": false, "requires_precision": false },
    { "name": "decimal", "category": "numeric", "requires_length": false, "requires_precision": false },
    { "name": "number", "category": "numeric", "requires_length": false, "requires_precision": false },
    { "name": "string", "category": "string", "requires_length": false, "requires_precision": false },
    { "name": "datetime", "category": "date", "requires_length": false, "requires_precision": false },
    { "name": "duration", "category": "other", "requires_length": false, "requires_precision": false },
    { "name": "uuid", "category": "other", "requires_length": false, "requires_precision": false },
    { "name": "bytes", "category": "binary", "requires_length": false, "requires_precision": false },
    { "name": "object", "category": "json", "requires_length": false, "requires_precision": false },
    { "name": "array", "category": "array", "requires_length": false, "requires_precision": false },
    { "name": "set", "category": "array", "requires_length": false, "requires_precision": false },
    { "name": "record", "category": "identifier", "requires_length": false, "requires_precision": false },
    { "name": "geometry", "category": "spatial", "requires_length": false, "requires_precision": false }
  ]
}
